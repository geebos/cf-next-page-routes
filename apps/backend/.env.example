# Backend uses PostgreSQL only.
# Root scripts: pnpm dev (Next.js + this backend), pnpm dev:api (backend only).
POSTGRES_URL=postgres://user:password@localhost:5432/database

# HTTP (defaults: 8787, 127.0.0.1).
# PORT=8787
# HOST=127.0.0.1

# Optional static site serving: point at the built Next export.
# Relative paths resolve from apps/backend (the pnpm script cwd).
# STATIC_ROOT=../frontend/out
# DEPLOY_MODE=both
