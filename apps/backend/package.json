{
  "name": "@repo/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env --watch src/serve.ts",
    "start": "tsx --env-file-if-exists=.env src/serve.ts",
    "build": "node scripts/build.mjs",
    "preview": "node --env-file-if-exists=.env dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@hono/zod-validator": "^0.8.0",
    "@repo/db": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/schemas": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.26",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
