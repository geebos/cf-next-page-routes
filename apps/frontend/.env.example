# Public site URL in format "schema://domain" (no path, no trailing slash, port allowed).
# Used for SEO canonical/hreflang URLs and as the API base URL.
# Required for production builds; optional in dev (web falls back to relative
# paths, Tauri falls back to DEFAULT_TAURI_BASE_URL in src/lib/api.ts).
NEXT_PUBLIC_BASE_URL=https://example.com

# Public media origin (optional). Empty means same-origin relative paths.
# Inlined at build time; changing it requires a rebuild.
NEXT_PUBLIC_ASSETS_BASE_URL=

# Deploy mode for `pnpm build`: both (default) | site | assets.
# site/assets trim the static export; see packages/schemas/src/static-assets.ts.
DEPLOY_MODE=both

# Dev-only proxy target for /api/* (default http://localhost:8787).
DEV_API_ORIGIN=http://localhost:8787
