{
  "name": "cf-next-pages-routes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "i18n:build": "pnpm --filter @repo/i18n codegen",
    "dev": "pnpm i18n:build && concurrently -k -n web,api \"pnpm --filter @repo/frontend dev\" \"pnpm --filter @repo/backend dev\"",
    "dev:web": "pnpm --filter @repo/frontend dev",
    "dev:api": "pnpm i18n:build && pnpm --filter @repo/backend dev",
    "build": "pnpm --filter @repo/frontend build",
    "start": "pnpm --filter @repo/backend start",
    "preview": "STATIC_ROOT=../frontend/out pnpm --filter @repo/backend preview",
    "lint": "eslint",
    "typecheck": "pnpm i18n:build && pnpm -r --if-present typecheck",
    "test": "pnpm i18n:build && pnpm -r --if-present test",
    "db:generate": "pnpm --filter @repo/db generate",
    "db:migrate": "pnpm --filter @repo/db migrate",
    "tauri": "pnpm --filter @repo/tauri exec tauri"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  }
}
