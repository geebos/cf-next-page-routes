{
  "name": "cf-next-pages-routes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker \"pnpm dev:web\" \"pnpm dev:worker\"",
    "dev:web": "pnpm --filter @repo/frontend dev",
    "dev:worker": "pnpm --filter @repo/backend dev",
    "build": "pnpm --filter @repo/frontend build",
    "start": "pnpm --filter @repo/frontend start",
    "preview": "pnpm --filter @repo/frontend preview",
    "lint": "eslint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @repo/db generate",
    "db:migrate": "pnpm --filter @repo/db migrate",
    "tauri": "pnpm --filter @repo/tauri exec tauri"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  }
}
