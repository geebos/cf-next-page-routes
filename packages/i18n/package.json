{
  "name": "@repo/i18n",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./compile": "./src/compile.ts",
    "./generated/manifest": "./generated/manifest.ts",
    "./generated/public": "./generated/public/index.ts",
    "./generated/private": "./generated/private/index.ts"
  },
  "scripts": {
    "codegen": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
